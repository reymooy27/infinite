generator client {
  provider = "prisma-client-js"
  // Runtime entry is .server-build/index.js at the repo root, so it resolves
  // @prisma/client from the root node_modules — generate there, not into server/.
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Connection {
  id                  Int      @id @default(autoincrement())
  name                String
  host                String
  port                Int      @default(22)
  username            String
  authType            String   @default("password") @map("auth_type")
  passwordEncrypted   String?  @map("password_encrypted")
  privateKeyEncrypted String?  @map("private_key_encrypted")
  createdAt           DateTime @default(now()) @map("created_at")
  userId              String   @default("local-user") @map("user_id")

  @@map("connections")
}

model Layout {
  id        String   @id @default(cuid())
  userId    String   @default("local-user") @map("user_id")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("layouts")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  url       String
  userId    String   @default("local-user") @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bookmarks")
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  content   String   @default("")
  userId    String   @default("local-user") @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String   @default("local-user") @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Project {
  id              String   @id @default(cuid())
  name            String
  userId          String   @default("local-user") @map("user_id")
  directory       String?  @map("directory")
  canvasData      Json
  canvasTransform Json?    @map("canvas_transform")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("projects")
}
