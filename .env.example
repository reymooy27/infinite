DATABASE_URL=file:./infinite.db
ENCRYPTION_SECRET=replace-with-64-char-random-hex
VITE_WS_URL=
ALLOWED_ORIGINS=http://localhost:9871
# URL for translator console logs SSE stream (default: http://localhost:20128/api/translator/console-logs/stream)
TRANSLATOR_CONSOLE_LOGS_URL=http://localhost:20128/api/translator/console-logs/stream

# OpenCode integration (optional). Leave empty for a native backend that can
# spawn `opencode serve` itself. Running in Docker? Fill both with one command:
#   npm run setup:opencode
OPENCODE_HOSTD_URL=
OPENCODE_HOSTD_TOKEN=
