# Docker environment — copy to .env and fill in ENCRYPTION_SECRET
# Usage: cp .env.docker .env && nano .env

# Required — generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Server
DATABASE_URL=file:/data/infinite.db
WS_PORT=7891
ALLOWED_ORIGINS=http://localhost:9871

# Frontend (build-time)
VITE_WS_URL=
